# ============================================================
# иэк.бел — переменные окружения
# Скопируй этот файл в .env и заполни свои значения:
#   cp .env.example .env
# .env в гит НЕ попадает (в .gitignore) — держи ключи только локально.
# ============================================================

# --- API личного кабинета ИЭК (lk.iek.ru) — ОБЯЗАТЕЛЬНО ---
# Логин и пароль от ЛК ИЭК (platforma). Нужны run.py (первое скачивание
# каталога на новом устройстве) и tools/import_lk.py (полная перевыгрузка).
# Где взять: личный кабинет platforma.iek.ru — доступы API.
LK_API_LOGIN=
LK_API_PASSWORD=

# --- необязательные ключи (можно вообще не заполнять) ---

# Graphify: семантическая разметка ДОКУМЕНТОВ в графе знаний.
# Код (python/js) разбирается локально без всяких ключей — ключ нужен
# только если хочешь индексировать PDF/доки в graphify-out.
# GEMINI_API_KEY=
